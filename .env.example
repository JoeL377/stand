# Everything is optional. With nothing set, the app runs in mock mode:
# no shared audio, transcription from the browser's own speech recognition,
# and heuristic notes instead of the LLM.

# LiveKit Cloud (https://cloud.livekit.io -> Settings -> API keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram streaming transcription (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic, for item notes and reading the shared screen
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Linear personal API key, to load a project or cycle as the agenda
LINEAR_API_KEY=

PORT=3001
# DATA_DIR=./data

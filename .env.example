# Everything is optional. With nothing set, the app runs in mock mode:
# no shared audio, transcription from the browser's own speech recognition,
# and heuristic notes instead of the LLM.

# LiveKit Cloud (https://cloud.livekit.io -> Settings -> API keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Transcription runs through LiveKit Inference on the LiveKit keys above.
# STT_MODEL=deepgram/nova-3
# Optional: use your own Deepgram account instead (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic, for item notes and reading the shared screen
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Live item notes (every few seconds) and the once-per-meeting tidy run + suggested agenda
# NOTES_MODEL=claude-haiku-5-5
# NOTES_TIDY_MODEL=claude-sonnet-5-5

# Linear personal API key, to load a project or cycle as the agenda
LINEAR_API_KEY=

# GitHub token that can read pull requests in the repos agents work in, so Stand checks a
# to-do off when the PR it was reported ready with merges (public repos work without it)
GITHUB_TOKEN=

# Google sign-in (Google Cloud console -> APIs & Services -> Credentials ->
# OAuth client ID, type "Web application"). Authorized redirect URI:
#   <your origin>/api/auth/google/callback   e.g. http://localhost:5173/api/auth/google/callback
# Without these, people sign in with an unverified name and email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may use the app. With both empty, anyone can sign in.
# Exact email addresses (comma-separated), e.g. ann@gmail.com,bo@acme.com
ALLOWED_EMAILS=
# Whole email domains (comma-separated), e.g. acme.com
ALLOWED_EMAIL_DOMAINS=
# Public origin when behind a proxy, e.g. https://standup.example.com
PUBLIC_URL=

PORT=3001
# DATA_DIR=./data

# Optional Conxt transcript delivery. Create the integration in Conxt's hosted /team app,
# then store its one-time credential here or in Railway server variables. Never commit it.
# Room owners still explicitly choose a destination and confirm sharing in Manage spaces.
# CONXT_DESTINATIONS=[{"key":"product","label":"Acme / Product","submissionUrl":"https://conxt-api.up.railway.app/api/v1/integrations/<integration-uuid>/sources","token":"<server-only-integration-token>"}]
